# ==========================================
# BACKEND CONFIGURATION (Render Web Service)
# ==========================================
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/krono_commerce?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_strong_random_256_bit_secret_in_production
JWT_EXPIRES_IN=7d

# Application URLs & CORS
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:3000

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway (Sandbox / Test Mode)
PAYMENT_PROVIDER_KEY=rzp_test_sandbox_key_id
PAYMENT_PROVIDER_SECRET=rzp_test_sandbox_key_secret
PAYMENT_WEBHOOK_SECRET=whsec_test_webhook_secret

# Transactional Email (SMTP / OTP & Reset Notifications)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_smtp_user
EMAIL_PASSWORD=your_smtp_password

# ==========================================
# FRONTEND CONFIGURATION (Render Static Site)
# ==========================================
VITE_API_BASE_URL=/api
